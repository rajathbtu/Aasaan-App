# Node modules
node_modules/

# Expo specific files
.expo/
.expo-shared/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log*

# Metro bundler cache
.metro/
packager-cache-*

# iOS build artifacts (only if you have ios folder from bare workflow)
ios/build/
ios/Pods/
ios/Podfile.lock

# Expo managed workflow: ignore the entire iOS project (regenerated by prebuild)
ios/

# Expo managed workflow: ignore the entire Android project (regenerated by
# prebuild), mirroring the `ios/` rule above.
#
# `frontend/android/` is NOT committed by design. CI runs
# `npx expo prebuild --platform android --clean` before every build, which
# recreates the whole native project from app.json + package.json. Committing
# it would let stale generated files (manifests, icons, MainActivity.kt,
# google-services.json, gradle wrapper) silently override app.json and cause
# confusing build failures.
#
# If you ever need a native change to persist, add it via an Expo config
# plugin or a `patch-package` patch -- not by editing frontend/android/.
android/

# The rules below are defence-in-depth: signing material must never be
# committed even if `android/` is ever un-ignored.
# See scripts/configure-android-release-signing.js.
*.keystore
*.jks
keystore.properties

# Misc
.DS_Store
*.swp
*.swo

# Environment files
#
# `.env` holds real API credentials (Google Places, Truecaller, Razorpay).
# It was previously committed with placeholder values; it must NOT be tracked.
# CI supplies these values from GitHub Secrets -- see the "Materialise .env"
# step in .github/workflows/deploy.yml.
.env
.env.local
.env.*.local
!.env.example

# IDE/project files
.vscode/
.idea/
*.iml

# Temporary files
tmp/
temp/

# Expo web builds
web-build/

# EAS build artifacts
dist/
build/

# Jest
coverage/

# NOTE: package-lock.json is intentionally NOT ignored.
# It is committed so CI can resolve the npm cache path
# (see .github/workflows/deploy.yml) and builds stay reproducible.
# Uncomment these only if you switch package managers.
# yarn.lock
# pnpm-lock.yaml