# Node modules
node_modules/

# Expo specific files
.expo/
.expo-shared/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log*

# Metro bundler cache
.metro/
packager-cache-*

# iOS build artifacts (only if you have ios folder from bare workflow)
ios/build/
ios/Pods/
ios/Podfile.lock

# Expo managed workflow: ignore the entire iOS project (regenerated by prebuild)
ios/

# Android build artifacts (only if you have android folder from bare workflow)
android/app/build/
android/.gradle/
android/local.properties

# Android release signing material.
# `android/` is regenerated by `npx expo prebuild` and is NOT committed, but
# these entries are defence-in-depth so a locally generated keystore or
# credentials file can never be committed by accident.
# See scripts/configure-android-release-signing.js.
android/keystore.properties
android/app/*.keystore
android/app/*.jks
*.keystore
*.jks

# Misc
.DS_Store
*.swp
*.swo

# Environment files
#
# `.env` holds real API credentials (Google Places, Truecaller, Razorpay).
# It was previously committed with placeholder values; it must NOT be tracked.
# CI supplies these values from GitHub Secrets -- see the "Materialise .env"
# step in .github/workflows/deploy.yml.
.env
.env.local
.env.*.local
!.env.example

# IDE/project files
.vscode/
.idea/
*.iml

# Temporary files
tmp/
temp/

# Expo web builds
web-build/

# EAS build artifacts
dist/
build/

# Jest
coverage/

# NOTE: package-lock.json is intentionally NOT ignored.
# It is committed so CI can resolve the npm cache path
# (see .github/workflows/deploy.yml) and builds stay reproducible.
# Uncomment these only if you switch package managers.
# yarn.lock
# pnpm-lock.yaml