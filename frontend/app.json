{
  "expo": {
    "name": "Aasaanly",
    "slug": "aasaanly-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash/splash-content-exact.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.aasaanly",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aasaanly uses your location to show nearby services.",
        "NSCameraUsageDescription": "Aasaanly uses the camera to capture a profile photo.",
        "NSPhotoLibraryUsageDescription": "Aasaanly uses your photo gallery to let you select a profile photo.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBAazR3Knx18n1pRiKSMPSz_U-TgZHndLE"
      }
    },
    "android": {
      "package": "com.aasaanly",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBAazR3Knx18n1pRiKSMPSz_U-TgZHndLE"
        }
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "scheme": "aasaanly",
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/new_request.wav"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Aasaanly to use the microphone so you can dictate your request.",
          "speechRecognitionPermission": "Allow Aasaanly to use speech recognition so you can dictate your request."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aasaanly to select a profile photo.",
          "cameraPermission": "Allow Aasaanly to take a profile photo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c1796e30-6945-429f-a7ad-ee17b6908e06"
      }
    }
  }
}