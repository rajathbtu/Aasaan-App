{
  "expo": {
    "name": "Aasaan",
    "slug": "aasaan-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.aasaan.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aasaan uses your location to show nearby services.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aasaan.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBFotGFTxQhwTd8kdd0QTBBpCouBlz-508"
        }
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "scheme": "aasaan",
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/new_request.wav"
          ]
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c1796e30-6945-429f-a7ad-ee17b6908e06"
      }
    }
  }
}
