// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PicModeration {
  under_review
  approved
  blocked

  @@map("pic_moderation_status")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  phoneNumber         String   @unique
  language            String
  role                Role? // Made nullable
  serviceProviderInfo ServiceProviderInfo? @relation("User_ServiceProvider")
  creditPoints        Int      @default(0)
  plan                Plan     @default(free)
  createdAt           DateTime @default(now())
  workRequests        WorkRequest[] @relation("UserWorkRequests")
  workRequestsAsSelectedProvider WorkRequest[] @relation("SelectedWorkRequests")
  notifications       Notification[]
  payments            Payment[] @relation("UserPayments")
  submittedRatings    Rating[] @relation("RatingSubmitter")
  receivedRatings     Rating[] @relation("RatingRecipient")
  ratingsScoreSum     Int      @default(0)
  ratingsCount        Int      @default(0)
  picUrl              String?
  picAssetId           String?
  picModeration       PicModeration @default(approved) @map("pic_moderation")
  pushToken           String?
  pushTokenPlatform   String?
  pushTokenUpdatedAt  DateTime?
}

model ServiceProviderInfo {
  id             String   @id @default(uuid())
  services       String[]
  workSinceYear  Int?
  birthYear      Int?
  gender         String?
  bio            String?
  location       Location? @relation("ServiceProviderLocation", fields: [locationId], references: [id])
  locationId     String?  @unique
  radius         Int
  user           User     @relation("User_ServiceProvider", fields: [userId], references: [id])
  userId         String   @unique
}

model Location {
  id        String   @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  serviceProviderInfo ServiceProviderInfo? @relation("ServiceProviderLocation")
}

model WorkRequest {
  id                String   @id @default(uuid())
  user              User     @relation("UserWorkRequests", fields: [userId], references: [id])
  userId            String
  service           String
  locationName      String
  locationLat       Float
  locationLng       Float
  tags              String[]
  createdAt         DateTime @default(now())
  status            WorkRequestStatus @default(active)
  boosted           Boolean  @default(false)
  acceptedProviders AcceptedProvider[]
  ratings           Rating[]
  selectedProvider  User?    @relation("SelectedWorkRequests", fields: [selectedProviderId], references: [id], onDelete: SetNull)
  selectedProviderId String?
  closedAt          DateTime?

  @@index([status, service, createdAt])
  @@index([userId, createdAt])
  @@index([selectedProviderId, status, closedAt])
}

model AcceptedProvider {
  id           String   @id @default(uuid())
  providerId   String
  acceptedAt   DateTime @default(now())
  workRequest  WorkRequest @relation(fields: [workRequestId], references: [id])
  workRequestId String

  @@unique([providerId, workRequestId])
  @@index([workRequestId])
}

model Rating {
  id           String   @id @default(uuid())
  ratedUserId  String
  ratedUser    User     @relation("RatingRecipient", fields: [ratedUserId], references: [id])
  submittedByUserId String
  submittedBy  User     @relation("RatingSubmitter", fields: [submittedByUserId], references: [id])
  stars        Int
  review       String?
  workRequest  WorkRequest @relation(fields: [workRequestId], references: [id])
  workRequestId String

  @@unique([workRequestId, submittedByUserId])
  @@index([ratedUserId])
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      NotificationType
  title     String
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
  data      Json?
}

model Service {
  id       String   @id
  name     String
  category String
  alias    String[] @default([]) // Alternate/local names for the service (e.g. "Safai", "Khana")
  tags     String[]
  icon     String   // Icon name for the service
  color    String   // Color code for the service
}

model Payment {
  id          String   @id @default(uuid())
  user        User     @relation("UserPayments", fields: [userId], references: [id])
  userId      String
  orderId     String   @unique
  paymentId   String?  @unique
  amount      Int      // Amount in paise
  currency    String   @default("INR")
  status      PaymentStatus @default(created)
  type        PaymentType
  description String?
  notes       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([type])
}

enum Role {
  endUser
  serviceProvider
}

enum Plan {
  free
  basic
  pro
}

enum WorkRequestStatus {
  active
  closed
}

enum NotificationType {
  newRequest
  requestAccepted
  ratingPrompt
  boostPromotion
  autoClosed
  planPromotion
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  cancelled
  refunded
}

enum PaymentType {
  boost
  subscription
  credit_purchase
}

model VoiceCallRecord {
  id                       String   @id @map("interaction_id")
  providerCallId           String?  @map("provider_call_id")
  callType                 String   @default("provider_onboarding") @map("call_type")
  source                   String   @default("sarvam")
  userId                   String?  @map("user_id")
  fromNumber               String?  @map("from_number")
  toNumber                 String?  @map("to_number")
  status                   String
  durationSeconds          Decimal? @map("duration_seconds")
  startedAt                DateTime? @map("started_at")
  endedAt                  DateTime? @map("ended_at")
  transcript               Json?
  inputAgentVariables      Json?    @map("input_agent_variables")
  outputAgentVariables     Json?    @map("output_agent_variables")
  extractionSchemaVersion  Int      @default(1) @map("extraction_schema_version")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([callType])
  @@index([status])
  @@index([userId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([startedAt])
  @@map("voice_call_records")
}
